SERVER_PORT=:8080

# PostgreSQL (ejemplo local / Neon)
DATABASE_URL=postgresql://usuario:password@host:5432/reservslot?sslmode=require
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Define la contraseña de tu base de datos
DB_PASSWORD=
DB_NAME=reservslot
DB_SSLMODE=require

# JWT settings
# Genera un secreto propio con: go run ./cmd/generate_secrets.go
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
JWT_RENEW_MINUTES=20

# Cookie settings
COOKIE_NAME=reservslot_token
# true en producción con HTTPS
COOKIE_SECURE=false

# CORS (frontend Angular en desarrollo)
CORS_ORIGIN=http://localhost:4200

# Carpeta pública servida por nginx (el código agrega /public y /imagenes)
PUBLIC_DIR=.

# Servido directo por Go (sin X-Accel-Redirect)
X_ACCEL_REDIRECT_PREFIX=
